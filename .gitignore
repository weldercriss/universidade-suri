# ============================================
# Universidade Suri — .gitignore
# ============================================

# ---------- Dependências ----------
node_modules/

# ---------- Build / Output ----------
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
*.local

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Variáveis de Ambiente ----------
# Ignora TODOS os .env, exceto os exemplos
.env
.env.local
.env.development
.env.production
.env.staging
!.env.example
!.env.test

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Testes e Cobertura ----------
coverage/
.nyc_output/
test-results/
playwright-report/

# ---------- IDE / Editor ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---------- Wrangler / Cloudflare ----------
.wrangler/
.dev.vars

# ---------- Vite ----------
.vite/

# ---------- Prisma ----------
# Migrations são versionadas, mas o client gerado não
# node_modules/.prisma/ já é coberto por node_modules/