# ==============================================
# Universidade Suri — Backend Environment Variables
# ==============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env real!

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development    # development | test | production

# ---------- Banco de Dados (PostgreSQL) ----------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5431/unisuri_db?schema=public

# Configurações individuais (usadas por scripts legados)
DATABASE_HOST=localhost
DATABASE_PORT=5431
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=unisuri_db

# ---------- Autenticação JWT ----------
# Gere secrets fortes com: openssl rand -hex 32
JWT_SECRET=              # mínimo 32 caracteres — OBRIGATÓRIO
JWT_EXPIRES_IN=15m       # access token: vida curta (15 min)
JWT_REFRESH_SECRET=      # mínimo 32 caracteres — OBRIGATÓRIO
JWT_REFRESH_EXPIRES_IN=7d  # refresh token: 7 dias, armazenado em cookie httpOnly

# ---------- Segurança ----------
BCRYPT_ROUNDS=12         # custo do bcrypt (10-14, padrão: 12)
ALLOWED_ORIGINS=http://localhost:5175  # CORS: separe múltiplos domínios com vírgula

# ---------- Google OAuth (opcional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Redis (opcional — para cache e rate limiting) ----------
REDIS_URL=redis://localhost:6379

# ---------- Observabilidade (opcional) ----------
SENTRY_DSN=              # DSN do Sentry para rastreamento de erros
