# ==============================================
# Universidade Suri — Backend Environment Variables
# ==============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env real!

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development    # development | test | production

# ---------- Banco de Dados (Supabase) ----------
# DATABASE_URL: URL com connection pooling (porta 6543)
# Formato: postgresql://postgres.[REFERENCIA_DO_PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# DIRECT_URL: URL direta para migrations (porta 5432)
# Formato: postgresql://postgres.[REFERENCIA_DO_PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Configurações individuais (usadas por scripts legados)
DATABASE_HOST=localhost
DATABASE_PORT=5431
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=unisuri_db

# ---------- Autenticação JWT ----------
# Gere secrets fortes com: openssl rand -hex 32
JWT_SECRET=              # mínimo 32 caracteres — OBRIGATÓRIO
JWT_EXPIRES_IN=15m       # access token: vida curta (15 min)
JWT_REFRESH_SECRET=      # mínimo 32 caracteres — OBRIGATÓRIO
JWT_REFRESH_EXPIRES_IN=7d  # refresh token: 7 dias, armazenado em cookie httpOnly

# ---------- Segurança ----------
BCRYPT_ROUNDS=12         # custo do bcrypt (10-14, padrão: 12)
ALLOWED_ORIGINS=http://localhost:5173  # CORS: separe múltiplos domínios com vírgula

# ---------- URLs ----------
FRONTEND_URL=http://localhost:5173  # usado no link de redefinição de senha

# ---------- Redis (opcional — para cache e rate limiting) ----------
REDIS_URL=redis://localhost:6379

# ---------- Observabilidade (opcional) ----------
SENTRY_DSN=              # DSN do Sentry para rastreamento de erros
